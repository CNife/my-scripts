[Unit]
Description=nmem 出站请求网关（background lane）
Documentation=https://github.com/CNife/my-scripts/tree/main/nmem_gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/nmem-gw
ExecStart=%h/.local/bin/uv run --no-project %h/.local/share/nmem-gw/gateway.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
